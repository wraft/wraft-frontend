{
  "name": "wraft-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "clean": "rm -rf node_modules && rm -rf pnpm-lock.yaml && turbo run clean",
    "dev": "turbo run dev",
    "docs": "turbo run docs --filter=@wraft/docs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint:fix": "turbo run lint:fix",
    "lint": "turbo run lint",
    "post-install": "husky install && turbo run post-install",
    "pre-commit": "lint-staged",
    "prepare": "husky install",
    "prettier": "prettier --check .",
    "release": "turbo run build --filter=docs^... && changeset publish",
    "security:audit": "pnpm audit --audit-level high",
    "security:audit:json": "pnpm audit --json",
    "version-packages": "changeset version"
  },
  "lint-staged": {
    "(apps|packages)/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@wraft/eslint-config": "^0.0.0",
    "@wraft/typescript-config": "^0.0.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.5",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0",
    "npm": "not supported"
  },
  "pnpm": {
    "overrides": {
      "ajv": "6.14.0",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "handlebars@>=4.0.0 <4.7.9": ">=4.7.9",
      "js-yaml@>=4.0.0 <4.1.1": "4.1.1",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "postcss@<8.5.10": ">=8.5.10",
      "tmp@<=0.2.3": ">=0.2.4",
      "next-auth>uuid": ">=14.0.0",
      "@storybook/addon-actions>uuid": ">=14.0.0",
      "webpack@>=5.49.0 <=5.104.0": ">=5.104.1"
    }
  }
}
